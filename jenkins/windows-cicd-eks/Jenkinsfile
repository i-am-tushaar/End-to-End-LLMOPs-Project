
/*
==============================================================
FILE: Jenkinsfile
PROJECT: End-to-End-LLMOps-Project
PURPOSE: Jenkins CI/CD Pipeline for AWS EKS Deployment
==============================================================

PIPELINE STAGES:

1. Checkout                  - Download source code.
2. Verify Tools              - Verify required tools.
3. Run Tests                 - Install dependencies and run tests.
4. AWS Authentication       - Verify AWS identity.
5. Docker Build              - Build Docker image.
6. Image Validation          - Verify Docker image.
7. ECR Login                 - Authenticate with Amazon ECR.
8. Push Image to ECR         - Upload Docker image.
9. Configure EKS             - Configure kubectl.
10. Verify Kubernetes        - Check cluster connection.
11. Deploy to EKS            - Deploy application.
12. Verify Deployment        - Verify application rollout.

IMPORTANT:

- Jenkins runs natively on Windows.
- AWS authentication uses the jenkins-eks profile.
- IAM Roles Anywhere must be configured.
- Kubernetes Secret must contain actual credentials.
- This pipeline does not create AWS infrastructure.
- Docker ECR credentials use a temporary isolated config.

==============================================================
*/


// ============================================================
// PIPELINE CONFIGURATION
// ============================================================

pipeline {

    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    environment {

        // AWS CONFIGURATION

        AWS_REGION = 'eu-north-1'
        // AWS region containing ECR and EKS resources.

        AWS_PROFILE = 'jenkins-eks'
        // AWS CLI profile configured with IAM Roles Anywhere.

        AWS_CONFIG_FILE = 'C:\\Windows\\System32\\config\\systemprofile\\.aws\\config'
        // AWS configuration file accessible to Jenkins LocalSystem.

        ECR_REGISTRY = '452975373208.dkr.ecr.eu-north-1.amazonaws.com'
        // Amazon ECR registry URL.

        ECR_REPOSITORY = 'end-to-end-llmops'
        // Amazon ECR repository name.

        EKS_CLUSTER_NAME = 'llmops-eks-cluster'
        // Amazon EKS cluster name.

        K8S_NAMESPACE = 'llmops'
        // Kubernetes namespace.

        // PYTHON CONFIGURATION

        PYTHONPATH = 'multi_doc_chat'
        // Python module path used by the application and tests.

        // CI TEST CONFIGURATION

        GROQ_API_KEY = 'dummy'
        // Dummy key for tests that do not make real API calls.

        GOOGLE_API_KEY = 'dummy'
        // Dummy key for tests that do not make real API calls.

        LLM_PROVIDER = 'google'
        // Select Google as the LLM provider during tests.
    }


    // ========================================================
    // PIPELINE STAGES
    // ========================================================

    stages {


        // ----------------------------------------------------
        // STAGE 1: CHECKOUT SOURCE CODE
        // ----------------------------------------------------

        stage('Checkout') {
            steps {

                checkout scm
                // Download source code from the configured Git branch.
            }
        }


        // ----------------------------------------------------
        // STAGE 2: VERIFY REQUIRED TOOLS
        // ----------------------------------------------------

        stage('Verify Tools') {
            steps {

                bat '''
                    REM Verify installed software versions

                    python --version
                    uv --version
                    docker --version
                    aws --version
                    kubectl version --client
                '''
            }
        }


        // ----------------------------------------------------
        // STAGE 3: RUN PROJECT TESTS
        // ----------------------------------------------------

        stage('Run Tests') {
            steps {

                bat '''

                    REM Install exact project dependencies from uv.lock
                    REM --frozen prevents changes to the lock file

                    uv sync --frozen

                    REM Execute all project tests using the project environment
                    REM --no-sync avoids another dependency synchronization

                    uv run --no-sync python -m pytest tests -v

                '''
            }
        }


        // ----------------------------------------------------
        // STAGE 4: VERIFY AWS AUTHENTICATION
        // ----------------------------------------------------

        stage('AWS Authentication') {
            steps {

                bat '''

                    REM Verify AWS identity using IAM Roles Anywhere

                    aws --profile jenkins-eks sts get-caller-identity --region eu-north-1

                '''
            }
        }


        // ----------------------------------------------------
        // STAGE 5: BUILD DOCKER IMAGE
        // ----------------------------------------------------

        stage('Docker Build') {
            steps {

                bat '''

                    REM Generate a unique image tag from Jenkins build number
                    REM Example: build-10, build-11, build-12

                    echo Docker Image Tag: build-%BUILD_NUMBER%

                    REM Build Docker image with the generated tag

                    docker build -t %ECR_REGISTRY%/%ECR_REPOSITORY%:build-%BUILD_NUMBER% .

                '''
            }
        }


        // ----------------------------------------------------
        // STAGE 6: VERIFY DOCKER IMAGE
        // ----------------------------------------------------

        stage('Image Validation') {
            steps {

                bat '''

                    REM Display the image tag being validated

                    echo Validating Docker Image: build-%BUILD_NUMBER%

                    REM Verify that the image exists locally

                    docker image inspect %ECR_REGISTRY%/%ECR_REPOSITORY%:build-%BUILD_NUMBER%

                '''
            }
        }


        // ----------------------------------------------------
        // STAGE 7: LOGIN TO AMAZON ECR
        // ----------------------------------------------------

        stage('ECR Login') {
            steps {

                bat '''

                    REM Create an isolated Docker configuration directory
                    REM This avoids the existing Windows credential helper

                    if not exist "%WORKSPACE%\\.docker-config" mkdir "%WORKSPACE%\\.docker-config"

                    REM Create a clean Docker configuration without a credential helper

                    > "%WORKSPACE%\\.docker-config\\config.json" echo {"auths":{}}

                    REM Authenticate Docker with Amazon ECR
                    REM Use the isolated configuration for this login

                    aws --profile jenkins-eks ecr get-login-password --region eu-north-1 | docker --config "%WORKSPACE%\\.docker-config" login --username AWS --password-stdin %ECR_REGISTRY%

                '''
            }
        }


        // ----------------------------------------------------
        // STAGE 8: PUSH IMAGE TO AMAZON ECR
        // ----------------------------------------------------

        stage('Push Image to ECR') {
            steps {

                bat '''

                    REM Push the same image tag generated in Stage 5
                    REM Reuse the isolated Docker configuration from Stage 7

                    docker --config "%WORKSPACE%\\.docker-config" push %ECR_REGISTRY%/%ECR_REPOSITORY%:build-%BUILD_NUMBER%

                '''
            }
        }


        // ----------------------------------------------------
        // STAGE 9: CONFIGURE KUBECTL FOR EKS
        // ----------------------------------------------------

        stage('Configure EKS') {
            steps {

                bat '''

                    REM Configure kubectl to communicate with the EKS cluster

                    aws eks update-kubeconfig --region eu-north-1 --name llmops-eks-cluster --profile jenkins-eks

                '''
            }
        }


        // ----------------------------------------------------
        // STAGE 10: VERIFY KUBERNETES CONNECTION
        // ----------------------------------------------------

        stage('Verify Kubernetes Connection') {
            steps {

                bat '''

                    REM Verify that the Kubernetes worker nodes are accessible

                    kubectl get nodes

                '''
            }
        }


        // ----------------------------------------------------
        // STAGE 11: DEPLOY APPLICATION TO EKS
        // ----------------------------------------------------

        stage('Deploy to EKS') {
            steps {

                bat '''

                    REM Create or update the Kubernetes namespace

                    kubectl apply -f k8s/namespace.yaml

                    REM Apply application configuration

                    kubectl apply -f k8s/configmap.yaml

                    REM Apply Kubernetes Deployment

                    kubectl apply -f k8s/deployment.yaml

                    REM Apply Kubernetes Service

                    kubectl apply -f k8s/service.yaml

                '''


                bat '''

                    REM Update the application Deployment with the new ECR image
                    REM Use the same Jenkins build number used in Docker Build

                    kubectl set image deployment/llmops-app llmops-container=%ECR_REGISTRY%/%ECR_REPOSITORY%:build-%BUILD_NUMBER% -n llmops

                '''
            }
        }


        // ----------------------------------------------------
        // STAGE 12: VERIFY DEPLOYMENT
        // ----------------------------------------------------

        stage('Verify Deployment') {
            steps {

                bat '''

                    REM Wait until the application rollout succeeds

                    kubectl rollout status deployment/llmops-app --namespace=llmops --timeout=300s

                '''


                bat '''

                    REM Display application Pods

                    kubectl get pods -n llmops

                    REM Display Kubernetes Services

                    kubectl get services -n llmops

                '''
            }
        }
    }


    // ========================================================
    // POST-BUILD ACTIONS
    // ========================================================

    post {

        success {

            echo 'LLMOps application deployment pipeline completed successfully.'

        }

        failure {

            echo 'LLMOps CI/CD pipeline failed. Check the Jenkins console output.'

        }

        always {

            echo 'Jenkins pipeline execution finished.'

            // Remove temporary Docker credentials after execution
            // This runs after both successful and failed builds.

            bat '''
                if exist "%WORKSPACE%\\.docker-config" rmdir /s /q "%WORKSPACE%\\.docker-config"
            '''
        }
    }
}
