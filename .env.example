
# ==========================================
# APPLICATION CONFIGURATION
# ==========================================

APP_NAME=End-to-End-LLMOps-Project
APP_ENV=development
DEBUG=True

# ==========================================
# LLM CONFIGURATION (GROQ)
# ==========================================

LLM_PROVIDER=groq

GROQ_API_KEY=your_groq_api_key

# Groq model
GROQ_MODEL_NAME=openai/gpt-oss-20b

# ==========================================
# EMBEDDING CONFIGURATION (HUGGING FACE)
# ==========================================

EMBEDDING_PROVIDER=huggingface

# Hugging Face embedding model (free, no API key required)
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional Google embeddings configuration
# Use only if EMBEDDING_PROVIDER=google
GOOGLE_API_KEY=your_google_api_key
GOOGLE_EMBEDDING_MODEL=models/text-embedding-004

# ==========================================
# VECTOR DATABASE CONFIGURATION
# ==========================================

VECTOR_STORE=faiss

# FAISS index directory
FAISS_INDEX_PATH=faiss_index

# ==========================================
# LANGSMITH OBSERVABILITY
# ==========================================

LANGCHAIN_TRACING_V2=true

LANGCHAIN_API_KEY=your_langsmith_api_key

LANGCHAIN_PROJECT=End-to-End-LLMOps-Project

LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ==========================================
# GROQ LLM JUDGE (EVALUATION)
# ==========================================

GROQ_JUDGE_MODEL=openai/gpt-oss-120b

# ==========================================
# FASTAPI CONFIGURATION
# ==========================================

HOST=0.0.0.0
PORT=8080
