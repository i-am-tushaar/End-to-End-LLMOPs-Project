## Description: Builds the customized Jenkins environment and installs its system dependencies and plugins.


# FILE: Dockerfile.jenkins
# PURPOSE:
# Creates a customized Jenkins image for the LLMOps project.
# Installs Python, Git, Docker CLI and required Jenkins plugins.
#
# USED BY:
# docker-compose.jenkins.yml

FROM jenkins/jenkins:lts

USER root

# Install required system dependencies.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-venv \
        git \
        docker.io \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create Python alias.
RUN ln -s /usr/bin/python3 /usr/local/bin/python

# Copy Jenkins plugin configuration.
COPY jenkins/plugins.txt /usr/share/jenkins/ref/plugins.txt

# Install required Jenkins plugins.
RUN jenkins-plugin-cli --plugin-file /usr/share/jenkins/ref/plugins.txt

# Root is used for local Docker socket access.
# Do not expose this Jenkins setup publicly.
